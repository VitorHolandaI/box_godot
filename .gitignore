# Godot-generated files
.godot/
.import/

# Export credentials and temporary files
export.cfg
export_credentials.cfg
*.tmp

# Local release artifacts
dist/*
!dist/README.md
# Binarios ficam so em dist/ (versionar aqui engorda o repo a cada release)
box-godot-linux*.x86_64
box-godot-windows*.exe
# Mapa de IPs reais usado pela publicacao (contem valores internos)
.publish-ip-map.txt

# Import sidecar de imagem de documentacao (nunca e carregada como recurso)
docs/imagens/*.import

# Instrucoes de agente (Claude Code, Codex, OpenCode, Cursor). Sao configuracao
# da maquina de quem desenvolve, nao do jogo: ficam no disco, fora do repo.
CLAUDE.md
AGENTS.md
.claude/
.opencode/
